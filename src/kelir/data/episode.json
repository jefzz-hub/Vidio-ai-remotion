  "subtitles": [
    {
      "start": 0.4,
      "end": 3.2,
      "text": "Nenek selalu bilang, kalau terdengar",
      "speaker": "narator"
    },
    {
      "start": 3.25,
      "end": 5.8,
      "text": "ketukan dari kolong rumah, jangan jawab.",
      "speaker": "narator"
    },
    {
      "start": 6.1,
      "end": 9.4,
      "text": "Malam itu, aku mendengarnya untuk pertama kali.",
      "speaker": "narator"
    },
    {
      "start": 10.3,
      "end": 12.9,
      "text": "Aku sedang menjaga Nenek.",
      "speaker": "narator"
    },
    {
      "start": 13.1,
      "end": 16.7,
      "text": "Lampu minyak tinggal separuh,",
      "speaker": "narator"
    },
    {
      "start": 17,
      "end": 19.7,
      "text": "dan hujan membuat suara di luar hampir tidak terdengar.",
      "speaker": "narator"
    },
    {
      "start": 20.4,
      "end": 22.9,
      "text": "Ketukan pertama datang tepat di bawah kakiku.",
      "speaker": "narator"
    },
    {
      "start": 23.2,
      "end": 25.8,
      "text": "Nenek membuka mata, lalu berbisik,",
      "speaker": "narator"
    },
    {
      "start": 26.1,
      "end": 29.5,
      "text": "Jauhkan kakimu dari lantai.",
      "speaker": "nenek"
    },
    {
      "start": 30.2,
      "end": 33,
      "text": "Ketukan kedua berpindah ke bawah tempat tidur.",
      "speaker": "narator"
    },
    {
      "start": 33.2,
      "end": 35.1,
      "text": "Aku mengangkat kaki.",
      "speaker": "narator"
    },
    {
      "start": 35.6,
      "end": 39.5,
      "text": "Dari sela papan, muncul cahaya yang bergerak pelan.",
      "speaker": "narator"
    },
    {
      "start": 40.3,
      "end": 42.8,
      "text": "Aku ingin memanggil Ibu.",
      "speaker": "narator"
    },
    {
      "start": 43,
      "end": 46,
      "text": "Tapi suara Ibu lebih dulu terdengar dari luar.",
      "speaker": "narator"
    },
    {
      "start": 46.3,
      "end": 49.7,
      "text": "Rani, buka pintunya. Ibu kedinginan.",
      "speaker": "ibu"
    },
    {
      "start": 50.2,
      "end": 52.6,
      "text": "Tanganku sudah menyentuh palang.",
      "speaker": "narator"
    },
    {
      "start": 52.8,
      "end": 55.8,
      "text": "Nenek tiba-tiba menggenggam lenganku.",
      "speaker": "narator"
    },
    {
      "start": 56.1,
      "end": 59.7,
      "text": "Ibumu sedang tidur di kamar. Jangan lihat ke jendela.",
      "speaker": "nenek"
    },
    {
      "start": 60.2,
      "end": 62.8,
      "text": "Ketukan ketiga tidak datang dari bawah.",
      "speaker": "narator"
    },
    {
      "start": 63.1,
      "end": 65.4,
      "text": "Suaranya tepat di belakangku.",
      "speaker": "narator"
    },
    {
      "start": 65.8,
      "end": 69.7,
      "text": "Di dinding, bayanganku tetap berdiri menghadap pintu.",
      "speaker": "narator"
    },
    {
      "start": 70.1,
      "end": 71.9,
      "text": "Aku sudah berbalik.",
      "speaker": "narator"
    },
    {
      "start": 72,
      "end": 73.8,
      "text": "Bayangan itu belum.",
      "speaker": "narator"
    },
    {
      "start": 74,
      "end": 75.4,
      "text": "Lalu kepalanya menoleh sendiri,",
      "speaker": "narator"
    },
